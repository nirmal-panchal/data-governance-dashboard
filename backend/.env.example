# PostgreSQL connection string (Neon free tier recommended).
# Get one at https://neon.tech — copy the "pooled" connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Port the API listens on (Render sets this automatically in production).
PORT=3000

# Comma-separated allowed CORS origins. Use * for local dev.
FRONTEND_ORIGIN="*"
